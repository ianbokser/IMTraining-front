VITE_USE_MOCKS=true
VITE_API_URL=http://localhost:3001

# Google OAuth: Client ID público del proyecto en Google Cloud Console
# ("APIs & Services → Credentials → OAuth client ID → Web application").
# Es el mismo Client ID que configurás en el backend (GOOGLE_CLIENT_ID).
# Si lo dejás vacío, el botón "Continuar con Google" no se renderiza.
VITE_GOOGLE_CLIENT_ID=
